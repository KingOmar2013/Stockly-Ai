# Copy to .env.local and fill in. .env.local is git-ignored — never commit real keys.

# Browser-side. Google Sign-In client id for the Sheets sync flow.
VITE_GOOGLE_CLIENT_ID=

# Server-side only. Used by the OCR proxy and by the assistant's brain.
ANTHROPIC_API_KEY=

# Model behind the voice/text assistant. Defaults to claude-opus-5 when unset.
AGENT_MODEL=claude-opus-5

# Server-side only. ElevenLabs is used for speech-to-text and text-to-speech only.
ELEVENLABS_API_KEY=

# Default voice. Free ElevenLabs plans can only use premade voices via the API;
# library/professional voices return 402 paid_plan_required.
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb

# Optional per-language voices. Each falls back to ELEVENLABS_VOICE_ID when empty.
ELEVENLABS_VOICE_ID_AR=
ELEVENLABS_VOICE_ID_EN=

ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
